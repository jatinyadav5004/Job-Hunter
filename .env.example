PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/jobhunter-ai
JWT_SECRET=super_secret_jwt_key_change_in_production_12345

# AI Provider Settings (Either GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini # 'gemini' or 'openai'

# Google OAuth (Gmail sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/email/oauth2callback/google

# Microsoft OAuth (Outlook sending)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/email/oauth2callback/microsoft

# Security & Limits
DEFAULT_DAILY_EMAIL_LIMIT=20
ENCRYPTION_SECRET=32_character_encryption_secret_key!
